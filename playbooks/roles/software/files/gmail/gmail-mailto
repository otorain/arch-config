#!/usr/bin/env python3
"""Route mailto: URLs to Gmail's web compose view in Chrome (--app).

Usage: gmail-mailto [mailto:...]
  with a mailto: URL  -> open the Gmail compose window for that message
  without arguments   -> open the Gmail inbox

The desktop entry (gmail.desktop) is registered as the x-scheme-handler/mailto
default, so clicking a mailto: link anywhere lands here.
"""
import subprocess
import sys
import urllib.parse

CHROME = "google-chrome-stable"
INBOX = "https://mail.google.com/mail/u/0/"


def main() -> None:
    url = sys.argv[1] if len(sys.argv) > 1 else ""
    if not url.lower().startswith("mailto:"):
        subprocess.Popen([CHROME, "--app=" + INBOX])
        return

    # Strip the mailto: scheme. Note: a malformed "mailto://address" is NOT
    # specially handled — that form is invalid, so it is parsed literally.
    body = url[len("mailto:"):]
    recipients, _, query = body.partition("?")

    def first(key: str) -> str:
        values = urllib.parse.parse_qs(query).get(key, [])
        return values[0] if values else ""

    params = {"view": "cm", "fs": "1"}
    if recipients:
        params["to"] = urllib.parse.unquote(recipients)
    for key, gmail_key in (
        ("subject", "su"),
        ("body", "body"),
        ("cc", "cc"),
        ("bcc", "bcc"),
    ):
        value = first(key)
        if value:
            params[gmail_key] = value

    subprocess.Popen([CHROME, "--app=" + INBOX + "?" + urllib.parse.urlencode(params)])


if __name__ == "__main__":
    main()
