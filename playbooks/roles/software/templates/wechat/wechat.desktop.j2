[Desktop Entry]
Name=wechat
Name[zh_CN]=微信
# Keep this user-level override so we control the launch flags if ever needed.
# wechat >= 4.1.13 runs natively on Wayland: the compositor drives fractional
# scaling, so do NOT re-add QT_SCALE_FACTOR -- it double-scales and breaks the
# UI (blank regions + misaligned clicks).
Exec=/opt/wechat/wechat %U
StartupNotify=true
Terminal=false
Icon=/usr/share/icons/hicolor/256x256/apps/wechat.png
Type=Application
Categories=Utility;
Comment=Wechat Desktop
Comment[zh_CN]=微信桌面版
