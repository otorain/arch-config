[Desktop Entry]
Name=wechat
Name[zh_CN]=微信
# 覆盖系统级 desktop：XWayland 下 1.25 分数缩放需应用侧缩放，否则模糊
Exec=env QT_SCALE_FACTOR=1.25 /opt/wechat/wechat %U
StartupNotify=true
Terminal=false
Icon=/usr/share/icons/hicolor/256x256/apps/wechat.png
Type=Application
Categories=Utility;
Comment=Wechat Desktop
Comment[zh_CN]=微信桌面版
