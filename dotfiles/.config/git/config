[init]
	defaultBranch = main

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[pager]
	blame = delta
	diff = delta
	log = delta
	show = delta

[delta]
	features = catppuccin-mocha
	line-numbers = true

# catppuccin theme (ships with this repo's dotfiles)
[include]
	path = ~/.config/git/catppuccin.gitconfig
