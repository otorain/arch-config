[init]
	defaultBranch = main

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[pager]
	blame = delta
	diff = delta
	log = delta
	show = delta

[delta]
	features = catppuccin-mocha
	line-numbers = true

# catppuccin 主题（本仓库 dotfiles 自带）
[include]
	path = ~/.config/git/catppuccin.gitconfig
