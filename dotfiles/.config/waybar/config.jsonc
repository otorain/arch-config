// Waybar config
// On laptops, change network.interface to "wlo1"
{
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 4,

    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock", "custom/weather"],
    "modules-right": ["disk", "network", "cpu", "memory", "pulseaudio", "tray"],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "sort-by-number": true
    },

    "hyprland/window": {
        "max-length": 60,
        "separate-outputs": true
    },

    // Disk space (was disk_space: path=/, shows free space)
    "disk": {
        "path": "/",
        "format": "<span></span> {free}",
        "interval": 60,
        "states": {
            "warning": 80,
            "critical": 90
        }
    },

    // Network
    "network": {
        "interface": "wlp6s0",
        "format-wifi": "<span></span>  {ipaddr}",
        "format-alt": "  {essid}  {bandwidthUpBytes}  {bandwidthDownBytes}",
        "format-disconnected": "<span>󰤮</span> 离线",
        "interval": 5
    },

    // CPU load
    "cpu": {
        "format": "<span></span>  {usage}%",
        "interval": 1
    },

    // Memory (click toggles swap)
    "memory": {
        "format": "<span>󰍛</span>  {used:0.1f}G/{total:0.1f}G",
        "format-alt": "<span>󰾴</span> {swapUsed:0.1f}G/{swapTotal:0.1f}G",
        "interval": 5
    },

    // Volume (click opens pavucontrol)
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "<span>󰝚</span> 静音",
        "format-icons": ["<span></span>", "<span></span>", "<span></span>"],
        "on-click": "pavucontrol"
    },

    // Clock (was time: %a %Y.%m.%d %H:%M)
    // Click toggles the lunar calendar popup (gtk4-layer-shell, like weather).
    // Tooltip off: the default one renders as an empty box with this format.
    "clock": {
        "format": "{:L%A %Y.%m.%d %H:%M}",
        "locale": "zh_CN.UTF-8",
        "interval": 60,
        "tooltip": false,
        "on-click": "~/.local/bin/calendar.py"
    },

    // Weather (Amap; key in ~/.config/weather/amap-key).
    // Click toggles a popup below the bar listing all cities; picking one
    // switches the default city.
    "custom/weather": {
        "exec": "~/.local/bin/weather.py",
        "interval": 900,
        "return-type": "json",
        "tooltip": false,
        "on-click": "~/.local/bin/weather.py --popup"
    },

    "tray": {
        "spacing": 8
    }
}
