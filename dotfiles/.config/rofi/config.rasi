configuration {
    font: "Noto Sans 12";
    terminal: "kitty";
    location: 0;
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "app";
    modi: "drun,window,calc,emoji";
    xoffset: 0;
    yoffset: 0;
}

/* Theme files live in ~/.local/share/rofi/themes/ (catppuccin mocha + size overrides) */
@theme "custom"
