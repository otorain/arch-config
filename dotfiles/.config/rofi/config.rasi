configuration {
    font: "Noto Sans 12";
    terminal: "kitty";
    location: 0;
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "app";
    modi: "drun,window,calc,emoji";
    xoffset: 0;
    yoffset: 0;
}

/* 主题文件在 ~/.local/share/rofi/themes/（catppuccin mocha + 尺寸覆盖） */
@theme "custom"
